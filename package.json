{
  "name": "nihonix-server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:sprint02": "ts-node -r tsconfig-paths/register test/sprint02.integration.ts",
    "test:api": "ts-node -r tsconfig-paths/register scripts/test-api.ts",
    "test:auth": "ts-node -r tsconfig-paths/register scripts/test-auth-flow.ts",
    "start:dev": "cross-env NODE_ENV=development nest start --watch --preserveWatchOutput",
    "start:dev:clean": "taskkill /f /im node.exe 2>nul || echo No node processes found && npm run start:dev",
    "start:debug": "cross-env NODE_ENV=development nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/src/main",
    "seed": "ts-node -r tsconfig-paths/register scripts/seed-all.ts",
    "seed:prod": "cross-env NODE_ENV=production ts-node -r tsconfig-paths/register scripts/seed-all.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d data-source.ts",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:run": "ts-node -r tsconfig-paths/register scripts/run-migrations.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d data-source.ts",
    "migration:run:prod": "cross-env NODE_ENV=production ts-node -r tsconfig-paths/register scripts/run-migrations.ts",
    "sync:schema:prod": "cross-env NODE_ENV=production ts-node -r tsconfig-paths/register scripts/sync-schema.ts",
    "start:deploy": "npm run start:prod",
    "start:deploy:with-seed": "npm run seed:prod && npm run start:prod",
    "start:deploy:with-migration": "npm run migration:run:prod && npm run start:prod",
    "start:deploy:full": "npm run migration:run:prod && npm run seed:prod && npm run start:prod"
  },
  "dependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.1",
    "@nestjs/typeorm": "^11.0.0",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^7.0.3",
    "@types/streamifier": "^0.1.2",
    "axios": "^1.13.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cloudinary": "^2.8.0",
    "dotenv": "^17.2.3",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.10",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "streamifier": "^0.1.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.27",
    "cross-env": "^10.1.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "moduleNameMapper": {
      "^@auth/(.*)$": "<rootDir>/modules/auth/$1",
      "^@users/(.*)$": "<rootDir>/modules/users/$1",
      "^@levels/(.*)$": "<rootDir>/modules/levels/$1",
      "^@topics/(.*)$": "<rootDir>/modules/topics/$1",
      "^@enums/(.*)$": "<rootDir>/common/enums/$1",
      "^@guards/(.*)$": "<rootDir>/common/guards/$1",
      "^@decorators/(.*)$": "<rootDir>/common/decorators/$1",
      "^@interfaces/(.*)$": "<rootDir>/common/interfaces/$1",
      "^@upload/(.*)$": "<rootDir>/modules/upload/$1",
      "^@models/(.*)$": "<rootDir>/common/models/$1",
      "^@services/(.*)$": "<rootDir>/services/$1"
    },
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
